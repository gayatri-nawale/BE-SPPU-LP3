						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "1. "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Greedy Method:"
								},
								{
									"type": "text",
									"text": " An algorithmic technique that makes the best possible local choice at each step to find a solution."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: Fractional Knapsack."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "2. "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Dynamic Programming:"
								},
								{
									"type": "text",
									"text": " An algorithmic technique that divides a problem into overlapping subproblems and stores their results to avoid repeated calculations."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: 0/1 Knapsack."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "3. "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Backtracking:"
								},
								{
									"type": "text",
									"text": " An algorithmic technique that builds a solution step by step and goes back whenever a choice leads to an invalid solution."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: N-Queens Problem."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "4. "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Branch and Bound:"
								},
								{
									"type": "text",
									"text": " An algorithmic technique that explores possible solutions and eliminates branches that cannot produce a better solution."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: Travelling Salesman Problem (TSP)."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "5. "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Divide and Conquer:"
								},
								{
									"type": "text",
									"text": " An algorithmic technique that divides a problem into smaller subproblems, solves them independently and combines their results."
								}
							]
						}
					]
				}
			},
