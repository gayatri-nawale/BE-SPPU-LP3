			"meta": {},
			"id": "shape:XFfWGzdhbK0S2Q7tm32g7",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1286.151667115176,
				"font": "sans",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "1. Proof of Work (PoW):"
								},
								{
									"type": "text",
									"text": " A consensus mechanism in which miners compete to solve complex mathematical puzzles to add new blocks."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: Bitcoin."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "2. Proof of Stake (PoS):"
								},
								{
									"type": "text",
									"text": " A consensus mechanism in which validators are selected based on the cryptocurrency they stake (lock) in the network."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: Ethereum."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "3. Delegated Proof of Stake (DPoS):"
								},
								{
									"type": "text",
									"text": " A consensus mechanism in which users vote for selected delegates who validate transactions and create blocks."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Example: EOS, TRON."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "4. Practical Byzantine Fault Tolerance (PBFT):"
								},
								{
									"type": "text",
									"text": " A consensus mechanism in which nodes communicate and vote to reach agreement, even if some nodes are faulty or malicious.(traitors eliminate, everyone aggree on one deiciosn)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "5. Proof of Activity:"
								},
								{
									"type": "text",
									"text": " A hybrid consensus mechanism that combines Proof of Work and Proof of Stake to validate and add blocks."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "6. Proof of Burn:"
								},
								{
									"type": "text",
									"text": " A consensus mechanism in which participants permanently destroy (burn) cryptocurrency to gain the opportunity to participate in block creation."
								}
							]
						}
					]
				}
			},
