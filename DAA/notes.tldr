						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Lossless compression reduces the data size without losing the original information. The original data can be recovered completely."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aDZ6A",
			"typeName": "shape"
		},
		{
			"x": 4153.1497636965205,
			"y": 6284.897784979798,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:tFZi5jbo52hosFqyU6WXE",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1465.1429443359375,
				"font": "sans",
				"textAlign": "start",
				"autoSize": true,
				"scale": 2.660372811584267,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Why do we create the DP table using "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "n + 1"
								},
								{
									"type": "text",
									"text": " and "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "k + 1"
								},
								{
									"type": "text",
									"text": "?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Because we need an extra row for zero items and an extra column for zero capacity. Both have maximum profit zero."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "abgYb",
			"typeName": "shape"
		},
		{
			"x": 1859.589118116981,
			"y": -474.02758628701946,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:vv5xZ9A_AzYgkSQuQ0fwD",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1044.933516817914,
				"font": "sans",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1.3112411036064333,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Fractional Knapsack is an optimization problem in which we select complete items or fractions of items to maximize the total profit without exceeding the given knapsack capacity."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "We sort items in descending order of their value-to-weight ratio because a higher ratio gives more profit per unit of weight. This helps us achieve maximum profit by selecting the most profitable items first."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aNLAv",
			"typeName": "shape"
		},
