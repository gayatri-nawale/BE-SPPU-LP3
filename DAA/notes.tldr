								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Tabulation is a bottom-up approach in Dynamic Programming. We solve smaller subproblems first using loops and store their results in a table."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aaTYM",
			"typeName": "shape"
		},
