												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Recursion stack: Can take O(n) space in the worst case when generating codes."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
