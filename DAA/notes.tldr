				}
			},
			"parentId": "page:page",
			"index": "a661A",
			"typeName": "shape"
		},
		{
			"x": 8568.159531092679,
			"y": -506.34549317457754,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:6pRf1ReAt_-tWWIO5gyBT",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1355.2441486744033,
				"font": "sans",
				"textAlign": "start",
				"autoSize": false,
				"scale": 4.541840479107684,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The N-Queens problem is a problem in which we have to place "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "N"
								},
								{
									"type": "text",
									"text": " queens on an "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "N × N"
								},
								{
									"type": "text",
									"text": " chessboard such that no two queens attack each other."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "we must make sure that no two queens are present in the same row, column, or diagonal."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "afhtE",
			"typeName": "shape"
		},
		{
			"x": 8556.528202186095,
			"y": 1314.7213345839796,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:VSBGp63xpjVRZzDfnKB-C",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 5026.588143640989,
				"font": "sans",
				"textAlign": "start",
				"autoSize": true,
				"scale": 4.491748735001199,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Time Complexity: O(N! × N)"
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 1,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "The program places queens row by row."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "It tries different column positions for each queen."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "In the worst case, it explores up to N! possible arrangements."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "For every position, the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "isSafe()"
												},
												{
													"type": "text",
													"text": " method checks the previous rows and diagonals, taking O(N) time."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Space Complexity: O(N²)"
								}
							]
						},
						{
							"type": "bulletList",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "The chessboard is an N × N matrix."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "It requires O(N²) space."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Recursion requires O(N) additional stack space."
												}
											]
										}
									]
								}
							]
						}
					]
				}
			},
