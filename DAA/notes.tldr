										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Each cell stores the maximum profit possible."
												}
											]
										}
									]
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
