												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Priority Queue: Stores at most O(n) nodes."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Huffman Tree: Contains n leaf nodes and n − 1 internal nodes, so total nodes = 2n − 1."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
