			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1030.7301962006318,
				"font": "sans",
				"textAlign": "start",
				"autoSize": false,
				"scale": 3.0428355362304416,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The 0/1 Knapsack problem is an optimization problem in which we select items to get maximum profit without exceeding the given knapsack capacity. Each item must be selected completely or not selected at all."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aZO3r",
			"typeName": "shape"
		}
	]
