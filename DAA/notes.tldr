								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Fractional Knapsack is an optimization problem in which we select complete items or fractions of items to maximize the total profit without exceeding the given knapsack capacity."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "We sort items in descending order of their value-to-weight ratio because a higher ratio gives more profit per unit of weight. This helps us achieve maximum profit by selecting the most profitable items first."
								}
							]
						}
					]
				}
			},
