											},
											"content": [
												{
													"type": "text",
													"text": "We select items starting from the highest ratio."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "If the complete item cannot fit, we select only the required fraction of that item.   Fraction formula: "
